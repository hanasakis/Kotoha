# =============================================================================
# Kotoha Commerce Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# =============================================================================
# Server
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ENV=development          # development | staging | production
LOG_LEVEL=debug          # debug | info | warn | error

# =============================================================================
# PostgreSQL — user, product, cart, order, payment
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=kotoha
DB_PASSWORD=
DB_NAME=kotoha
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# =============================================================================
# Redis — session, cart cache, rate limit, hot search cache
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# Milvus — product vector search
# =============================================================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=
MILVUS_DB=kotoha

# HNSW index params
MILVUS_HNSW_M=30
MILVUS_HNSW_EF_CONSTRUCTION=64
MILVUS_EF_SEARCH=80

# Hybrid search weights
MILVUS_DENSE_WEIGHT=0.65
MILVUS_BM25_WEIGHT=0.35
MILVUS_RECALL_TOP_K=40

# =============================================================================
# MinIO / S3 — product images
# =============================================================================
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=kotoha-images
S3_USE_SSL=false

# =============================================================================
# Stripe — payment
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cny

# =============================================================================
# JWT — authentication
# =============================================================================
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h          # 30 days

# =============================================================================
# Langfuse — observability & evaluation
# =============================================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# AI / LLM — Ollama (local models)
# =============================================================================
OLLAMA_HOST=http://localhost:11434

# Main Commerce Agent brain
LLM_MODEL=qwen3.5:9b
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# Embedding model for product text vectorization
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIM=1024

# Vision model for product image understanding
VISION_MODEL=qwen3.5-9b-r7-vision

# Reranker model (optional)
RERANK_MODEL=qwen3:0.6b

# =============================================================================
# i18n
# =============================================================================
DEFAULT_LOCALE=zh             # zh | en
SUPPORTED_LOCALES=zh,en

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_AGENT_ENABLED=true
FEATURE_PAYMENT_ENABLED=true
FEATURE_OBSERVABILITY_ENABLED=true
